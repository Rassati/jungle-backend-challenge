{
  "name": "jungle-backend-challenge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.1",
  "scripts": {
    "start": "bun src/main.ts",
    "demo:sqs": "bun scripts/demo-sqs.ts",
    "test": "bun test ./tests/unit ./tests/integration --timeout 30000",
    "test:unit": "bun test ./tests/unit",
    "test:integration": "bun test ./tests/integration --timeout 30000",
    "db:migrate": "bun src/infrastructure/database/migrate.ts up",
    "db:rollback": "bun src/infrastructure/database/migrate.ts down",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1160.0",
    "@mikro-orm/core": "6.6.0",
    "@mikro-orm/migrations": "6.6.0",
    "@mikro-orm/postgresql": "6.6.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "decimal.js": "10.6.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/bun": "1.3.1",
    "@types/express": "5.0.3",
    "typescript": "5.9.3"
  }
}
